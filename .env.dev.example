# AI Job Portal - Development Environment
# Copy to .env.dev and fill in values

# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://postgres:<password>@ai-job-portal-dev.czemc0204jzt.ap-south-1.rds.amazonaws.com:5432/ai_job_portal_dev

# Database Details
# Host: ai-job-portal-dev.czemc0204jzt.ap-south-1.rds.amazonaws.com
# Port: 5432
# Database: ai_job_portal_dev
# Username: postgres
# Region: ap-south-1 (Mumbai)

# AI Recommendation Model
AI_MODEL_URL=http://ai-job-portal-dev-alb-1152570158.ap-south-1.elb.amazonaws.com/ai
# Master switch for AI calls. Set to "false" to skip AI and use safe fallbacks
# (SQL recommendations / pattern-based resume parsing). Roll out false before any
# AI service teardown to avoid 5xx cascades.
AI_ENABLED=true
# AI service endpoint paths. Defaults match the current contract. Override to point
# at the new ai-prototype-service routes when it ships.
AI_RECOMMEND_PATH=/recommend
AI_PARSE_PATH=/parse
AI_PARSE_STATUS_PATH=/parse-status

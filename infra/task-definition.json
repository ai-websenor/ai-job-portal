{
  "family": "ai-job-portal-dev-ai-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::868991777791:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::868991777791:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "ai-service",
      "image": "868991777791.dkr.ecr.ap-south-1.amazonaws.com/ai-job-portal/ai-service:latest",
      "portMappings": [
        {
          "containerPort": 3010,
          "hostPort": 3010,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "S3_BUCKET", "value": "ai-job-portal-dev-uploads" },
        { "name": "S3_RESUME_PREFIX", "value": "resumes/" },
        { "name": "SAGEMAKER_ENDPOINT_NAME", "value": "resume-parser-mistral" },
        { "name": "MAX_FILE_SIZE_MB", "value": "10" },
        { "name": "DATABASE_URL", "value": "REPLACE_WITH_DB_URL" },
        { "name": "AWS_ACCESS_KEY_ID", "value": "REPLACE_WITH_ACCESS_KEY" },
        { "name": "AWS_SECRET_ACCESS_KEY", "value": "REPLACE_WITH_SECRET_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-job-portal-dev/ai-service",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

# Environment files with secrets
.env
.env.dev
.env.local
.env.production
.env.staging
.env.deploy
.env.*.local

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.turbo/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
coverage/

# Drizzle (migration files in packages/database/drizzle/ are tracked for staging/production)

# Docker
docker/*.env
docker/.env.*
!docker/.env.*.example

# Firebase service account keys
*-firebase-adminsdk-*.json

# Misc
.cache/
tmp/
CLAUDE.md

# Markdown docs — keep local only (already-tracked .md files on dev remain tracked)
*.md
# Exception: content management integration guide is shared with frontend devs
!DOCS/content_management.md

# AI engine (Python/FastAPI) — resume parsing, job chat, recommendations,
# resume scoring, salary estimation. Its source now lives in this repo.
#
# The standalone github.com/ai-websenor/jobboard-ai-engine checkout is still
# physically present in this folder because the ECS deploy pipeline runs from
# it. Its .git stays out of this repo so the two never try to own each other,
# and so `git add` here can never turn the folder into a gitlink.
jobboard-ai-engine/.git/
jobboard-ai-engine/.venv/
jobboard-ai-engine/venv/
jobboard-ai-engine/.pytest_cache/
jobboard-ai-engine/.claude/
jobboard-ai-engine/.turbo/
# Binary reference material used for manual parser testing — large, and not
# something the build or the tests read.
jobboard-ai-engine/docs/*.docx
jobboard-ai-engine/docs/*.xlsx
jobboard-ai-engine/docs/test-docs/
jobboard-ai-engine/docs/test-json-result/
# `*.md` above is a repo-wide ignore aimed at stray notes. The engine's
# markdown is source: its changelog and its runbooks.
!jobboard-ai-engine/**/*.md
